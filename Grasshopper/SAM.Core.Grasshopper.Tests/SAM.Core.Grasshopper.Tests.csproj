<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- These are compile-time reference assemblies only: Rhino.Testing loads the real,
         installed Rhino 8 + Grasshopper runtime in-process (see Rhino.Testing.Configs.xml),
         so the NuGet copies must not shadow it on disk. -->
    <ShouldRemoveRhinoReferences>True</ShouldRemoveRhinoReferences>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grasshopper" Version="8.21.25188.17001" Private="False" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="RhinoCommon" Version="8.21.25188.17001" Private="False" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="Rhino.Testing" Version="8.0.28-beta" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SAM.Core.Grasshopper\SAM.Core.Grasshopper.csproj" />
    <ProjectReference Include="..\SAM.Geometry.Grasshopper\SAM.Geometry.Grasshopper.csproj" />
    <ProjectReference Include="..\SAM.Core.Grasshopper.Tests.Fixtures\SAM.Core.Grasshopper.Tests.Fixtures.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Rhino.Testing.Configs.xml" CopyToOutputDirectory="Always" />
  </ItemGroup>

</Project>
